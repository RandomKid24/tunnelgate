---
interface Props {
  title: string;
  description?: string;
}
const { title, description = 'One-click RDP through a secure tunnel. No terminals. No config files. Just connect.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400&display=swap" />
    <link rel="stylesheet" href="/styles/global.css" />
  </head>
  <body>
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false"><defs>
      <filter id="sketch" x="-5%" y="-5%" width="110%" height="110%"><feTurbulence type="fractalNoise" baseFrequency="0.018" numOctaves="2" seed="4" result="n" /><feDisplacementMap in="SourceGraphic" in2="n" scale="4" /></filter>
    </defs></svg>
    <a href="#main-content" class="skip">Skip to content</a>
    <nav>
      <div class="nav-inner">
        <a href="/" class="nav-brand">
          <img src="/logo.png" alt="TunnelGate" />
          TunnelGate
        </a>
        <ul class="nav-links">
          <li><a href="#how-it-works">How it works</a></li>
          <li><a href="#setup">Setup</a></li>
          <li><a href="#features">Features</a></li>
          <li><a href="#faq">FAQ</a></li>
        </ul>
      </div>
    </nav>
    <main id="main-content"><slot /></main>
  </body>
</html>
