---
import Layout from '../layouts/Layout.astro';

const features = [
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>`,
    title: 'Built-in RDP viewer',
    desc: 'FreeRDP 3 renders your remote desktop right inside the app — full keyboard, mouse, wheel and fullscreen.',
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>`,
    title: 'Nothing to install',
    desc: 'The secure tunnel and the RDP engine ship inside TunnelGate. One app, no dependencies, no PATH setup.',
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="8" y="2" width="8" height="4" rx="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="M9 12h6"/><path d="M9 16h4"/></svg>`,
    title: 'Copy / paste that works',
    desc: 'Text clipboard syncs both ways between your machine and the remote session — the same as your usual RDP client.',
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
    title: 'Zero Trust routing',
    desc: 'Every connection goes through a Zero Trust tunnel. Your IT team controls who connects and from where.',
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/></svg>`,
    title: 'Dynamic resolution',
    desc: "Matches your display. Fullscreen adapts to your screen's native aspect ratio — even 3:2 and 16:10 touchscreens.",
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>`,
    title: 'Auto-reconnect',
    desc: 'Survives network blips with exponential backoff. Your session stays alive through WiFi switches and brief dropouts.',
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>`,
    title: 'Encrypted credentials',
    desc: 'Passwords stored with OS-level encryption — DPAPI on Windows, Keychain on macOS, libsecret on Linux. Never plaintext.',
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
    title: 'WiFi-gated access',
    desc: 'Optionally restrict connections to approved office networks. HRMS-managed whitelist, enforced at connect time.',
  },
];

const faqs = [
  {
    q: 'What does TunnelGate actually do?',
    a: 'It combines a secure tunnel and a built-in RDP viewer in one app. You add your server details once, click connect, and your remote desktop appears — no terminal commands.',
  },
  {
    q: 'Do I need a tunnel client or RDP client installed separately?',
    a: 'No. The tunnel client and the FreeRDP 3 engine ship inside the app and are updated with it.',
  },
  {
    q: 'Does copy and paste work?',
    a: 'Yes — text copies both directions between your computer and the remote session, automatically, like your usual RDP client. Files, printers and audio are not redirected.',
  },
  {
    q: 'How do I disconnect?',
    a: 'Click the "← Back" button in the session toolbar. Esc is not a disconnect key — it goes to the remote desktop, or exits fullscreen when you are fullscreen.',
  },
  {
    q: 'How are my credentials stored?',
    a: "Passwords are encrypted at rest using your operating system's built-in keychain — DPAPI on Windows, Keychain on macOS, libsecret on Linux. They're never logged or sent anywhere except the remote server during authentication.",
  },
  {
    q: 'Which platforms are supported?',
    a: 'Windows (x64), macOS (Apple Silicon), and Linux (x64).',
  },
  {
    q: 'What happens if my connection drops?',
    a: 'TunnelGate reconnects automatically with exponential backoff. Your session state is preserved and the viewer resumes when the connection comes back.',
  },
  {
    q: 'Can I use my own RDP client instead?',
    a: 'Yes. Every tunnel has an "Open Native Client" button that launches mstsc on Windows, Microsoft Remote Desktop on macOS, or xfreerdp on Linux — with your credentials pre-filled.',
  },
  {
    q: 'How do I get TunnelGate?',
    a: 'Ask your IT team for the installer for your platform. You need Zero Trust access to be set up for you and a remote machine that allows RDP.',
  },
];
---

<Layout title="TunnelGate — One-click secure RDP">

  <!-- Hero -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <h1 class="display-xl">One-click RDP through a <span class="accent">secure tunnel.</span></h1>
        <p class="lead">No terminals. No config files. Add your server, click connect, and your remote desktop appears.</p>
        <div class="actions">
          <a href="#setup" class="btn btn-signal">Setup guide</a>
          <a href="#how-it-works" class="ulink">How it works</a>
        </div>
      </div>
      <div class="surface-ink term" aria-hidden="true">
        <div class="term-bar">TunnelGate</div>
<pre>$ tunnelgate
<span class="dim">Starting secure tunnel...</span>
<span class="ok">✓</span> <span class="dim">Tunnel ready</span>
<span class="ok">✓</span> <span class="dim">Connecting to office-pc.acme.com</span>
<span class="ok">✓</span> <span class="dim">RDP session active (1920×1080)</span>
<span class="ok">✓</span> <span class="dim">Clipboard sync ready</span>
<span class="dim">Click ← Back to disconnect</span></pre>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="section bone" id="how-it-works">
    <div class="wrap">
      <div class="head">
        <p class="label">How it works</p>
        <h2 class="display-lg">Four steps. No terminal required.</h2>
      </div>
      <ol class="steps">
        <li class="step"><div class="step-num">01</div><h3 class="display-md">Add your server</h3><p class="body-tight">Enter hostname, username, password. Encrypted and stored locally.</p></li>
        <li class="step"><div class="step-num">02</div><h3 class="display-md">Click connect</h3><p class="body-tight">The secure tunnel is created automatically. No command line needed.</p></li>
        <li class="step"><div class="step-num">03</div><h3 class="display-md">View your desktop</h3><p class="body-tight">Your remote desktop appears in the app with full keyboard, mouse and fullscreen.</p></li>
        <li class="step"><div class="step-num">04</div><h3 class="display-md">Click Back</h3><p class="body-tight">A clean disconnect tears down the session. Esc stays yours: it goes to the remote desktop.</p></li>
      </ol>
    </div>
  </section>

  <!-- Setup -->
  <section class="section" id="setup">
    <div class="wrap cols">
      <div>
        <p class="label">Before you start</p>
        <h2 class="display-lg" style="margin-bottom:32px">What you need</h2>
        <ul class="checks">
          <li><span>✓</span><p><strong>Zero Trust access.</strong> Your IT team sets this up and adds you to the access policy.</p></li>
          <li><span>✓</span><p><strong>A remote Windows machine with RDP enabled.</strong> Go to System Settings → Remote Desktop → Enable, and note the hostname.</p></li>
          <li><span>✓</span><p><strong>Your Windows login.</strong> The username and password you use on the remote machine.</p></li>
        </ul>
        <p class="note">That's it. The tunnel client and the RDP engine are bundled inside TunnelGate. <strong>Nothing else to install.</strong></p>
      </div>
      <div>
        <p class="label">Setup</p>
        <h2 class="display-lg" style="margin-bottom:32px">Running in five minutes</h2>
        <ol class="setup-steps">
          <li><span class="setup-num">1</span><div><h3>Get TunnelGate</h3><p>Get the installer for your platform from your IT team.</p></div></li>
          <li><span class="setup-num">2</span><div><h3>Install and sign in</h3><p>Open TunnelGate and sign in with your HRMS credentials. This checks you against your company's access policy.</p></div></li>
          <li><span class="setup-num">3</span><div><h3>Add your server</h3><p>Click "Add Tunnel" and enter the <code>hostname</code>, your Windows <code>username</code> and <code>password</code>. Give it a friendly name.</p></div></li>
          <li><span class="setup-num">4</span><div><h3>Connect</h3><p>TunnelGate creates a secure tunnel, authenticates, and opens your remote desktop in one click.</p></div></li>
        </ol>
      </div>
    </div>
  </section>

  <!-- Architecture -->
  <section class="section bone" id="architecture">
    <div class="wrap cols">
      <div>
        <p class="label">Under the hood</p>
        <h2 class="display-lg" style="margin-bottom:24px">Your IT team stays in control</h2>
        <p class="body" style="margin-bottom:16px">Every connection goes through a Zero Trust tunnel. Access is gated by HRMS login and can be limited to approved office WiFi networks. Traffic is encrypted end to end.</p>
        <p class="body">Credentials never leave your machine. Passwords are encrypted with the OS keychain and sent only to the remote server during RDP authentication.</p>
      </div>
      <div class="stack" role="img" aria-label="Your machine connects through a secure edge to your RDP server">
        <div class="stack-box">
          <p class="label">Your machine</p>
          <div class="stack-row"><span class="chip on">TunnelGate app</span><span class="chip">FreeRDP 3</span><span class="chip">Tunnel client</span></div>
        </div>
        <div class="stack-link">TLS 443</div>
        <div class="stack-box ink">
          <p class="label">Secure edge</p>
          <div class="stack-row"><span class="chip on">Zero Trust policy</span></div>
        </div>
        <div class="stack-link">Encrypted</div>
        <div class="stack-box">
          <p class="label">Your RDP server</p>
          <div class="stack-row"><span class="chip on">RDP 3389</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="section" id="features">
    <div class="wrap">
      <div class="head">
        <p class="label">Features</p>
        <h2 class="display-lg">Everything you need. Nothing you don't.</h2>
      </div>
      <ul class="features">
        {features.map((f) => (
          <li class="feature">
            <div set:html={f.icon} />
            <h3 class="display-md">{f.title}</h3>
            <p class="body-tight">{f.desc}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section bone" id="faq">
    <div class="wrap">
      <div class="head">
        <p class="label">FAQ</p>
        <h2 class="display-lg">Common questions</h2>
      </div>
      <div class="faq">
        {faqs.map((faq) => (
          <details>
            <summary>{faq.q}</summary>
            <p>{faq.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta surface-ink">
    <div class="wrap">
      <h2 class="display-lg">Ready to connect?</h2>
      <p class="lead" style="color:rgba(242,247,249,.8)">Add your server and connect in one click.</p>
      <a href="#setup" class="btn btn-invert">Setup guide</a>
    </div>
  </section>

  <footer>
    <div class="wrap footer-inner">
      <div class="footer-left"><img src="/logo.png" alt="" /> TunnelGate &middot; forged by beforth</div>
      <ul class="footer-links">
        <li><a href="https://github.com/RandomKid24/cloudflareRDB-gui" target="_blank" rel="noopener">GitHub</a></li>
        <li><a href="https://github.com/RandomKid24/cloudflareRDB-gui/issues" target="_blank" rel="noopener">Issues</a></li>
      </ul>
    </div>
  </footer>

</Layout>
